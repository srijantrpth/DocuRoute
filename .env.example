# ---------------------------------------------------------------------------
# DocuRoute — copy to .env and fill in. Never commit the filled file.
# The backend reads ./.env and ./backend/.env; the frontend reads ./frontend/.env
# (only VITE_* keys are exposed to the browser).
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Database --------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string (URI, pooler).
# Leave blank to fall back to a local SQLite file.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>
SUPABASE_SERVICE_ROLE_KEY=<service role key — server only, never in the frontend>
# Legacy HS256 projects: Project Settings > API > JWT Secret.
# New projects using asymmetric signing keys: leave blank and the API verifies
# against https://<ref>.supabase.co/auth/v1/.well-known/jwks.json instead.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=documents

# --- Signer magic links ----------------------------------------------------
# Must be at least 32 bytes. Rotating this invalidates every outstanding link.
SIGNING_TOKEN_SECRET=change-me-to-a-different-32-plus-byte-random-string
SIGNING_TOKEN_ISSUER=docuroute
SIGNING_TOKEN_TTL_HOURS=168

# --- Email -----------------------------------------------------------------
# Left unset, invitations print to the API console (fine for local development).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=<smtp password>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DocuRoute <no-reply@yourdomain.com>

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# --- Frontend (frontend/.env) ---------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Firebase Analytics — optional, all seven keys required to initialise.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
